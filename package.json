{
  "name": "web-selection",
  "version": "0.3.0",
  "description": "Paint to select: a zero-dependency brush that picks parts of any web page, and turns them into context an AI model can read.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowl3860/web-selection.git"
  },
  "homepage": "https://github.com/meowl3860/web-selection#readme",
  "bugs": {
    "url": "https://github.com/meowl3860/web-selection/issues"
  },
  "keywords": [
    "selection",
    "brush",
    "dom",
    "shadow-dom",
    "ai",
    "llm",
    "context",
    "multimodal",
    "browser-extension"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/types/context/index.d.ts",
      "import": "./dist/context.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "fixtures": "vite",
    "example": "vite --open /examples/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && playwright test",
    "check": "npm run typecheck && npm test && npm run e2e",
    "shots": "node scripts/shoot.mjs shots",
    "real": "node scripts/real.mjs real-shots",
    "eval": "node tests/eval/run.mjs",
    "bench": "node scripts/build.mjs && node tests/bench/run.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
