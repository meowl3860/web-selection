{
  "manifest_version": 3,
  "name": "Web Selection (try it)",
  "version": "0.1.0",
  "description": "Photoshop-style selection on any page. Click the button or press Alt+Shift+S.",
  "action": {
    "default_title": "Select on this page (Alt+Shift+S)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Turn the selection tools on or off"
    }
  }
}
