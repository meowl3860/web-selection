{
  "manifest_version": 3,
  "name": "Web Selection",
  "version": "0.3.0",
  "description": "Paint over any web page with a brush to select its elements.",
  "action": {
    "default_title": "Web Selection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "toggle-brush": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn the brush on or off"
    }
  }
}
